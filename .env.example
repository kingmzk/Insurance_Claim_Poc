# ==============================================================================
# Autonomous Multi-Agent Insurance Claims PoC - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your credentials:
#   Windows: copy sample.env .env
#   Linux/macOS: cp sample.env .env
# ==============================================================================

# Google Gemini API Key
# Required for live LLM extraction, policy RAG rationale, and DeepEval evaluation metrics.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider mode: "gemini" (live API) or "mock" (deterministic rule-based fallback)
LLM_PROVIDER=gemini

# SQLite Database Storage Path
DATABASE_PATH=data/claims.db

# Straight-Through Processing (STP) Maximum Authority Limit ($)
# Claims exceeding this approved payout require human claims adjuster sign-off.
DEFAULT_AUTHORITY_LIMIT=5000.0

# Senior Adjuster Max Payout Approval Limit ($)
# Claims above this amount require senior claims manager approval.
SENIOR_ADJUSTER_APPROVAL_LIMIT=10000.0

# Standard Default Policyholder Deductible ($)
DEFAULT_DEDUCTIBLE=500.0

# Fraud Risk Scoring Thresholds (0 - 100 Scale)
# Claims with fraud_score >= 75 immediately freeze automation and alert SIU.
FRAUD_THRESHOLD_ESCALATION=75

# Claims with fraud_score < 25 qualify for automated STP clearance.
FRAUD_THRESHOLD_LOW=25

# FastAPI Backend Server Configuration (defaults to 8000 to match Vite proxy)
API_HOST=127.0.0.1
API_PORT=8000
# Allowed CORS origins for frontend web client (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ==============================================================================
# Langfuse LLM & Agent Observability
# ==============================================================================
# Track multi-agent execution traces, LLM token generations, latency, and quality scores.
# Sign up at: https://cloud.langfuse.com (or use self-hosted)
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ==============================================================================
# OpenTelemetry (OTel) Distributed Tracing & Metrics
# ==============================================================================
# Service name identifier emitted in resource attributes
OTEL_SERVICE_NAME=insurance-claims-orchestrator

# Optional standard OTLP HTTP/Proto collector endpoint (e.g. Jaeger, Grafana Tempo, SigNoz, Datadog)
# Leave blank to use built-in thread-safe in-memory ring-buffer diagnostics
# Examples:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.grafana.net/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Enable stdout console span logging for local terminal debugging (true/false)
OTEL_TRACES_CONSOLE=false

